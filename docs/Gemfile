source "https://rubygems.org"

# Local preview uses modern Jekyll. GitHub Pages uses Jekyll 3.9.x via the
# github-pages gem; behavior is equivalent for the cayman theme + simple
# pages we use here, but the Liquid 4.0.3 pinned by github-pages depends
# on String#tainted? removed in Ruby 3.2+. So locally we use Jekyll 4.
gem "jekyll", "~> 4.3"

gem "just-the-docs"
gem "jekyll-seo-tag"
gem "jekyll-sitemap"

# Stdlib pieces removed from Ruby 3.4+
gem "csv"
gem "logger"
gem "base64"
gem "bigdecimal"
gem "webrick", "~> 1.7"
